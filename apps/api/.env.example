# Copy this file to apps/api/.env to override defaults. Every value is optional.

# Port the API listens on.
PORT=8787

# Host the API binds to. Use 0.0.0.0 only if you deliberately want LAN access.
HOST=localhost

# SQLite database file, resolved relative to apps/api/.
DATABASE_PATH=data/business-cards.db

# Browser origin allowed to call the API (defaults to the Vite dev server).
CORS_ORIGIN=http://localhost:5173
